  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @threatveil/web dev",
    "build": "pnpm --filter @threatveil/web build",
    "typecheck": "pnpm --filter @threatveil/web typecheck",
