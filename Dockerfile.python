# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.13@sha256:b485bd65cc2cf1c9a93b3554012c9c3778cf7b1b5fd3d3096ce9e1226c97e1e6 AS uv
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:54df941ed0d06a1bd95ef5e0ce391fd8d9f94b64782dc9a60062727849ee3f97 AS runtime-base
FROM python:3.14-slim-trixie@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6 AS sqlite-build
# Compilers stay in this build stage. APT authenticates Debian's build-tool packages.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:1e71ddf93849c6a6ecf58b827c0692073d2dd7ee40196158068f7b29f422e87d https://www.sqlite.org/2026/sqlite-amalgamation-3530400.zip /tmp/sqlite-amalgamation.zip
COPY infra/scripts/build_sqlite.py /tmp/build_sqlite.py
RUN python /tmp/build_sqlite.py
FROM python:3.14-slim-trixie@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6 AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev
# Mount point for local state (compose.yaml); a named volume inherits its ownership.
RUN mkdir /app/.local
COPY --from=runtime-base / /runtime-base/
COPY --from=sqlite-build /opt/threatveil-sqlite/libsqlite3.so.0 /opt/threatveil-sqlite/libsqlite3.so.0
COPY --from=sqlite-build /opt/threatveil-sqlite/sqlite.cdx.json /opt/threatveil-sqlite/sqlite.cdx.json
COPY infra/scripts/prepare_python_runtime.py /tmp/prepare_python_runtime.py
# Keep the official current CPython binary/stdlib; package installation is build-only.
RUN python -m pip uninstall --yes pip && rm -rf /usr/local/lib/python3.13/ensurepip && rm -f /usr/local/bin/uv && python /tmp/prepare_python_runtime.py

FROM runtime-base AS runtime
# Dependencies arrive through the locked build; no shell or package manager is shipped.
COPY --from=build /runtime-rootfs/ /
WORKDIR /app
COPY --from=build --chown=10001:10001 /app /app
COPY --chown=10001:10001 alembic.ini ./alembic.ini
COPY --chown=10001:10001 migrations ./migrations
ARG SOURCE_REVISION=UNKNOWN
ARG BUILD_TIME=UNKNOWN
ENV PATH="/app/.venv/bin:$PATH" LD_LIBRARY_PATH=/usr/local/lib PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TV_LOCAL_AUTH=false TV_SOURCE_REVISION=$SOURCE_REVISION TV_BUILD_TIME=$BUILD_TIME
USER 10001:10001
EXPOSE 8080
ENTRYPOINT []
CMD ["uvicorn", "threatveil.api:app", "--host", "0.0.0.0", "--port", "8080"]
