# ThreatVeil environment template.
#
#   cp .env.example .env
#
# Nothing in this file is required: `docker compose up --build`, the synthetic demo and the
# test suite all run with it absent. Fill in only what you use. Never commit .env, and never
# put a credential in target or source configuration: ThreatVeil stores credential
# references, not secrets.
#
# Every TV_* variable maps to a field in src/threatveil/config.py. Dictionary fields must stay
# valid JSON ({}), and booleans must be true or false.

# --- Docker Compose (compose.yaml) -----------------------------------------------------
# Blank values use local placeholders. The database port is never published.
TV_POSTGRES_PASSWORD=
TV_DB_ADMIN_PASSWORD=
TV_DB_APP_PASSWORD=
# Host ports (bound to 127.0.0.1). If you change TV_WEB_PORT, set TV_WEB_ORIGIN to match.
# TV_WEB_PORT=3000
# TV_API_PORT=8000

# --- Core --------------------------------------------------------------------------------
# Browser origin the API trusts for sign-in and CSRF. Must match the address you open
# exactly: http://127.0.0.1:3000 and http://localhost:3000 are different origins.
TV_WEB_ORIGIN=http://127.0.0.1:3000
TV_EVIDENCE_DIR=.local/evidence
# local | test | dev | staging | production. Local identity (TV_LOCAL_AUTH) is refused
# outside local/test. compose.yaml and `make dev-api` set both explicitly; leave them unset
# here so the test suite controls them.
# TV_ENV=local
# TV_LOCAL_AUTH=true

# Host development: scripts/local_db.sh writes these to .local/database.env for you.
# TV_DATABASE_URL=postgresql+psycopg://threatveil_app:<password>@127.0.0.1:55432/threatveil
# TV_ADMIN_DATABASE_URL=postgresql+psycopg://threatveil_admin:<password>@127.0.0.1:55432/threatveil

# --- CLI and SDK clients -------------------------------------------------------------------
# Scoped token issued under Settings -> Developer. Keep it out of shell history.
# TV_API_URL=http://127.0.0.1:8000
# TV_API_TOKEN=

# --- Optional: AI assistance (off by default; proposal-only, never changes assurance) ----
TV_AI_PROVIDER=disabled
TV_OPENAI_API_KEY=
TV_COMPILER_MODEL=gpt-5.4-mini-2026-03-17

# --- Optional: GitHub App (signed webhooks, check runs) ------------------------------------
TV_GITHUB_APP_ID=
TV_GITHUB_PRIVATE_KEY=
TV_GITHUB_WEBHOOK_SECRET=

# --- Optional: signing ---------------------------------------------------------------------
# Operator Ed25519 private key (PEM). Blank locally: a LOCAL_DEMONSTRATION key is created
# under .local/receipt-signing/ and labelled as such. Required outside local/test.
TV_RECEIPT_SIGNING_PRIVATE_KEY=

# --- Hosted deployment only (GCP; see docs/deployment/GCP.md, never accepted) -------------
TV_FIREBASE_PROJECT=
TV_SECRET_PROJECT=
TV_EVIDENCE_BUCKET=
TV_SENTRY_DSN=

# --- Commercial remnants from the startup (not needed for anything above) -----------------
# Versioned commercial catalog; blank uses bundled launch hypotheses.
TV_COMMERCIAL_CATALOG_PATH=
# disabled maps to mock only locally; hosted mock mode is prohibited.
TV_BILLING_PROVIDER=disabled
TV_STRIPE_SECRET_KEY=
TV_STRIPE_WEBHOOK_SECRET=
TV_STRIPE_PRICES={}
TV_STRIPE_TRIAL_ALLOWANCES={}
TV_COMMERCIAL_PLANS={}
TV_STRIPE_LIVE_CHARGES_ENABLED=false
# Explicit nonlive entitlements only after configured Stripe TEST acceptance.
TV_STRIPE_TEST_ENTITLEMENTS_ENABLED=false
TV_HUBSPOT_DELIVERY_ENABLED=false
TV_HUBSPOT_OWNER_ID=
TV_HUBSPOT_TOKEN=
TV_RESEND_DELIVERY_ENABLED=false
TV_RESEND_API_KEY=
TV_EMAIL_FROM=

# --- Web build (read by Next.js at build time) ---------------------------------------------
# Optional separate Next build directory for isolated local acceptance.
# TV_NEXT_DIST_DIR=.next-category
# Top-bar contact link label; set to an empty string to hide it.
# NEXT_PUBLIC_TV_CONTACT_LABEL=
